{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "w3c-web-serial"
    ],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "shared/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": [
    "node_modules",
    ".sdk",
    "build",
    "dist",
    "DerivedData*"
  ]
}
